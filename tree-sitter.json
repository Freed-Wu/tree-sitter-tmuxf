{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "tmuxf",
      "camelcase": "Tmuxf",
      "title": "tmux format string",
      "scope": "source.tmuxf",
      "file-types": [
        "tmuxf"
      ],
      "injection-regex": "^tmuxf$",
      "class-name": "TreeSitterTmuxf"
    }
  ],
  "metadata": {
    "version": "0.0.4",
    "license": "MIT",
    "description": "🌲👨 tmux format ststring grammar for tree-sitter ",
    "authors": [
      {
        "name": "Wu",
        "email": "wuzhenyu@ustc.edu",
        "url": "https://github.com/Freed-Wu"
      }
    ],
    "links": {
      "repository": "https://github.com/Freed-Wu/tree-sitter-tmux",
      "funding": "https://github.com/Freed-Wu/tree-sitter-tmux"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "java": true,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": true
  }
}
