{
  "name": "tree-sitter-tmuxf",
  "version": "0.0.1",
  "description": "🌲👨 tmux format ststring grammar for tree-sitter ",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/freed-wu/tree-sitter-tmux.git"
  },
  "funding": "https://github.com/Freed-Wu/tree-sitter-tmux",
  "license": "MIT",
  "author": {
    "name": "Wu",
    "email": "wuzhenyu@ustc.edu",
    "url": "https://github.com/Freed-Wu"
  },
  "main": "bindings/node",
  "types": "bindings/node",
  "keywords": [
    "incremental",
    "parsing",
    "tree-sitter",
    "tmuxf"
  ],
  "files": [
    "grammar.js",
    "tree-sitter.json",
    "binding.gyp",
    "prebuilds/**",
    "bindings/node/*",
    "queries/*",
    "src/**",
    "*.wasm"
  ],
  "dependencies": {
    "node-addon-api": "^8.5.0",
    "node-gyp-build": "^4.8.4"
  },
  "devDependencies": {
    "prebuildify": "^6.0.1",
    "tree-sitter": "^0.25.0",
    "tree-sitter-cli": "^0.26.8"
  },
  "peerDependencies": {
    "tree-sitter": "^0.25.0"
  },
  "peerDependenciesMeta": {
    "tree-sitter": {
      "optional": true
    }
  },
  "scripts": {
    "install": "node-gyp-build",
    "prestart": "tree-sitter build --wasm",
    "start": "tree-sitter playground",
    "test": "node --test bindings/node/*_test.js"
  }
}
